\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Case 2：LAX 问题}{6}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Case 2 LAX 问题：MacCormack 数值解与精确解对比。激波和接触间断附近的误差更明显，人工粘性会使间断变宽。}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:case2}{{2}{7}{Case 2 LAX 问题：MacCormack 数值解与精确解对比。激波和接触间断附近的误差更明显，人工粘性会使间断变宽。}{figure.caption.5}{}}
