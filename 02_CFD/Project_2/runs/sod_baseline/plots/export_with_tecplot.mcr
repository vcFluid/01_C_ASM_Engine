#!MC 1410

$!READDATASET  '"C:\WorkStation\40_Workspace\01_C_ASM_Engine\02_CFD\Project_2\runs\sod_automation_test\plots\numerical_exact_combined.dat"'
  INITIALPLOTTYPE = XYLINE
  INCLUDETEXT = NO
  INCLUDEGEOM = NO

$!PLOTTYPE = XYLINE
$!DELETELINEMAPS
$!CREATELINEMAP
$!LINEMAP [1] NAME = 'MacCormack'
$!LINEMAP [1] ASSIGN{ZONE = 1}
$!LINEMAP [1] ASSIGN{XAXISVAR = 1}
$!LINEMAP [1] LINES{COLOR = RED}
$!LINEMAP [1] LINES{LINETHICKNESS = 0.4}
$!CREATELINEMAP
$!LINEMAP [2] NAME = 'Exact'
$!LINEMAP [2] ASSIGN{ZONE = 2}
$!LINEMAP [2] ASSIGN{XAXISVAR = 1}
$!LINEMAP [2] LINES{COLOR = BLACK}
$!LINEMAP [2] LINES{LINETHICKNESS = 0.8}
$!ACTIVELINEMAPS = [1-2]
$!GLOBALLINEPLOT LEGEND{SHOW = YES}
$!GLOBALLINEPLOT LEGEND{TEXTSHAPE{SIZEUNITS = POINT}}
$!GLOBALLINEPLOT LEGEND{TEXTSHAPE{HEIGHT = 10}}
$!XYLINEAXIS XDETAIL 1 {TITLE{TITLEMODE = USETEXT}}
$!XYLINEAXIS XDETAIL 1 {TITLE{TEXT = 'x'}}
$!EXPORTSETUP EXPORTFORMAT = PNG
$!EXPORTSETUP IMAGEWIDTH = 1400

$!LINEMAP [1] ASSIGN{YAXISVAR = 2}
$!LINEMAP [2] ASSIGN{YAXISVAR = 2}
$!XYLINEAXIS YDETAIL 1 {TITLE{TITLEMODE = USETEXT}}
$!XYLINEAXIS YDETAIL 1 {TITLE{TEXT = 'Density, rho'}}
$!VIEW DATAFIT
$!XYLINEAXIS XDETAIL 1 {RANGEMIN = 0}
$!XYLINEAXIS XDETAIL 1 {RANGEMAX = 1}
$!XYLINEAXIS YDETAIL 1 {RANGEMIN = 0.08125}
$!XYLINEAXIS YDETAIL 1 {RANGEMAX = 1.04375}
$!EXPORTSETUP EXPORTFNAME = "C:\WorkStation\40_Workspace\01_C_ASM_Engine\02_CFD\Project_2\runs\sod_automation_test\plots\tecplot_rho.png"
$!EXPORTSTART
$!EXPORTFINISH

$!LINEMAP [1] ASSIGN{YAXISVAR = 3}
$!LINEMAP [2] ASSIGN{YAXISVAR = 3}
$!XYLINEAXIS YDETAIL 1 {TITLE{TITLEMODE = USETEXT}}
$!XYLINEAXIS YDETAIL 1 {TITLE{TEXT = 'Velocity, u'}}
$!VIEW DATAFIT
$!XYLINEAXIS XDETAIL 1 {RANGEMIN = 0}
$!XYLINEAXIS XDETAIL 1 {RANGEMAX = 1}
$!XYLINEAXIS YDETAIL 1 {RANGEMIN = -0.051025899285}
$!XYLINEAXIS YDETAIL 1 {RANGEMAX = 1.071543884985}
$!EXPORTSETUP EXPORTFNAME = "C:\WorkStation\40_Workspace\01_C_ASM_Engine\02_CFD\Project_2\runs\sod_automation_test\plots\tecplot_u.png"
$!EXPORTSTART
$!EXPORTFINISH

$!LINEMAP [1] ASSIGN{YAXISVAR = 4}
$!LINEMAP [2] ASSIGN{YAXISVAR = 4}
$!XYLINEAXIS YDETAIL 1 {TITLE{TITLEMODE = USETEXT}}
$!XYLINEAXIS YDETAIL 1 {TITLE{TEXT = 'Pressure, p'}}
$!VIEW DATAFIT
$!XYLINEAXIS XDETAIL 1 {RANGEMIN = 0}
$!XYLINEAXIS XDETAIL 1 {RANGEMAX = 1}
$!XYLINEAXIS YDETAIL 1 {RANGEMIN = 0.055}
$!XYLINEAXIS YDETAIL 1 {RANGEMAX = 1.045}
$!EXPORTSETUP EXPORTFNAME = "C:\WorkStation\40_Workspace\01_C_ASM_Engine\02_CFD\Project_2\runs\sod_automation_test\plots\tecplot_p.png"
$!EXPORTSTART
$!EXPORTFINISH
